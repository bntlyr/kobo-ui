{
  "name": "kobo-ui",
  "version": "1.0.10",
  "description": "A beautifully crafted Angular component library with Tailwind CSS v4 and CDK.",
  "author": "Kobo UI Team",
  "license": "MIT",
  "keywords": [
    "angular",
    "components",
    "tailwind",
    "ui",
    "shadcn"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bntlyr/kobo-ui.git"
  },
  "homepage": "https://github.com/bntlyr/kobo-ui#readme",
  "bugs": {
    "url": "https://github.com/bntlyr/kobo-ui/issues"
  },
  "bin": {
    "kobo": "./bin/kobo.cjs",
    "kobo-ui": "./bin/kobo.cjs"
  },
  "exports": {
    "./assets/*": "./assets/*",
    "./*": "./*"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng-packagr -p ng-package.json",
    "publish:lib": "npm run build:lib && npm publish dist/kobo-ui",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "registry:build": "npx tsx scripts/build-registry.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": false,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@lucide/angular": ">=0.300.0",
    "class-variance-authority": ">=0.7.0",
    "clsx": ">=2.0.0",
    "tailwind-merge": ">=2.0.0",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/animations": "^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0 || ^23.0.0",
    "@angular/cdk": "^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0 || ^23.0.0",
    "@angular/common": "^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0 || ^23.0.0",
    "@angular/core": "^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0 || ^23.0.0",
    "@angular/forms": "^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0 || ^23.0.0",
    "@angular/platform-browser": "^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0 || ^23.0.0",
    "@angular/router": "^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0 || ^23.0.0",
    "rxjs": "^6.5.3 || ^7.4.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/animations": {
      "optional": true
    },
    "@angular/cdk": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    },
    "@angular/platform-browser": {
      "optional": true
    },
    "@angular/router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/animations": "^21.2.23",
    "@angular/build": "^21.1.1",
    "@angular/cdk": "^21.2.14",
    "@angular/cli": "^21.1.1",
    "@angular/common": "^21.2.23",
    "@angular/compiler-cli": "^21.1.0",
    "@angular/core": "^21.2.23",
    "@angular/forms": "^21.2.23",
    "@angular/platform-browser": "^21.2.23",
    "@angular/router": "^21.2.23",
    "@tailwindcss/postcss": "^4.1.12",
    "highlight.js": "^11.12.0",
    "jsdom": "^27.1.0",
    "ng-packagr": "^21.2.7",
    "postcss": "^8.5.3",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "zone.js": "^0.15.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true
  }
}