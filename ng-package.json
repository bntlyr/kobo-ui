{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "dist/kobo-ui",
  "lib": {
    "entryFile": "src/public-api.ts",
    "cssUrl": "inline"
  },
  "assets": [
    { "glob": "*.css", "input": "src/styles", "output": "assets" },
    { "glob": "*.css", "input": "src/styles", "output": "." },
    { "glob": "**/*", "input": "public/registry", "output": "registry" },
    "AGENTS.md",
    "LICENSE",
    { "glob": "*", "input": "bin", "output": "bin" }
  ],
  "allowedNonPeerDependencies": [
    "clsx",
    "tailwind-merge",
    "class-variance-authority",
    "@lucide/angular"
  ]
}
